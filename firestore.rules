rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidBorangPenerimaan(data) {
      return data.keys().hasAll(['namaMurid', 'tahun', 'kelas', 'namaPenjaga', 'hubungan', 'tarikhPenerimaan', 'jumlahBukuDiterima', 'bukuDiterima', 'createdAt', 'statusLengkap', 'tandatanganPenjaga', 'tandatanganMurid'])
          && data.namaMurid is string
          && data.tahun is string
          && data.kelas is string
          && data.namaPenjaga is string
          && data.hubungan is string
          && data.tarikhPenerimaan is string
          && data.bukuDiterima is string
          && data.jumlahBukuDiterima is number
          && data.statusLengkap is bool
          && data.tandatanganPenjaga is string
          && data.tandatanganMurid is string
          && data.createdAt is timestamp;
    }

    match /borang_penerimaan/{borangId} {
      allow create: if isValidId(borangId) && isValidBorangPenerimaan(incoming()) && incoming().createdAt == request.time;
      allow read, update, delete: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
